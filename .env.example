# ── Clerk (авторизация студентов) ────────────────────────────────────────────
# Берутся в dashboard.clerk.com → твоё приложение → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Куда Clerk ведёт после входа/регистрации
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ── Neon Postgres (данные о прогрессе) ───────────────────────────────────────
# console.neon.tech → проект → Connection string (pooled)
POSTGRES_URL=postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require

# ── Админка /admin ───────────────────────────────────────────────────────────
# Почты через запятую — только они видят дашборд
ADMIN_EMAILS=3tdream@gmail.com

# ── Уже было ─────────────────────────────────────────────────────────────────
FAL_API_KEY=
